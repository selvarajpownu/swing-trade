# swing-trade configuration
# Copy to .env (never commit .env):
#   macOS/Linux:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
# Format: KEY=value, one per line. Put double quotes around values that contain spaces.

# ---------------------------------------------------------------------------
# API (services/api)
# ---------------------------------------------------------------------------

# Address the API listens on. Keep 0.0.0.0 inside Docker.
BIND_ADDR=0.0.0.0:8080

# Shared secret. Every /v1/* call needs "Authorization: Bearer <API_TOKEN>".
# Generate one:  openssl rand -hex 32
# The web app sends the same value from the server side; it never reaches the browser.
API_TOKEN=change-me-to-a-long-random-string

# Set to true only for local experiments to run the API without a token. Never in production.
ALLOW_NO_TOKEN=false

# Market-data sources, tried in order. "demo" needs no account.
# Use DATA_PROVIDERS=demo to run without INDmoney.
DATA_PROVIDERS=indmoney,demo

# INDmoney MCP connector. Log in once with: cargo run -p api-server -- login indmoney
INDMONEY_MCP_URL=https://mcp.indmoney.com/mcp
# Where the OAuth token is stored. Relative paths resolve from the API's working directory
# (services/api/.data/ when run with cargo, /app/.data/ = ./.data/ in Docker).
INDMONEY_TOKEN_FILE=.data/indmoney-token.json
# Optional: use this access token instead of the token file.
INDMONEY_ACCESS_TOKEN=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Default watchlist (NSE symbols, comma-separated).
WATCHLIST=COFORGE,MCX,CAMS,IEX,ACE,AJAXENGG,ASKAUTOLTD,PERSISTENT,OFSS,BSE

# Position sizing defaults: capital in rupees, risk as a fraction of capital per trade (0.01 = 1%).
DEFAULT_CAPITAL=500000
DEFAULT_RISK=0.01

# Background scanner (GET /v1/scan, Scanner page, Home "Top setups").
# Universe: UNIVERSE_FILE (one symbol per line, or an NSE constituent CSV such as the Nifty 500 list),
# else UNIVERSE (comma separated), else WATCHLIST. INDRAMEDCO is always excluded.
# UNIVERSE_FILE=.data/nifty500.csv
# UNIVERSE=
# SCAN_EXCLUDE=
# SCAN_INTERVAL_MINS=30
# SCAN_SYMBOLS_PER_MIN=15
# CANDLE_STORE_DIR=.data/candles
# Client-side INDmoney budget (cost units per minute; the server allows 60).
# INDMONEY_RATE_PER_MIN=55

# In-memory cache lifetimes in seconds.
QUOTE_TTL_SECS=15
CANDLE_TTL_SECS=600

# Logging: RUST_LOG filter, LOG_FORMAT=json (servers) or pretty (local dev).
RUST_LOG=info
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------

# Where the Next.js server reaches the API. Docker Compose overrides this to http://api:8080.
API_URL=http://localhost:8080
# API_TOKEN above is reused by the web server. Do not prefix it with NEXT_PUBLIC_.

# Shown in the page title and header. NEXT_PUBLIC_* values are baked in at build time.
NEXT_PUBLIC_APP_NAME="Swing Trade"
