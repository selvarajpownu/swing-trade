# Normalise line endings: LF in the repo and in working trees,
# except Windows scripts which need CRLF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated lockfiles: hide from diffs by default
package-lock.json linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff
